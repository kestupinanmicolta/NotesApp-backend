meta {
  name: Update Note
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/notes/{{noteId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Nota actualizada",
    "content": "Contenido actualizado desde Bruno",
    "latitude": 4.71111,
    "longitude": -74.07222,
    "locationName": "Chapinero, Bogotá"
  }
}

docs {
  Update a note by id. `title` is required. Send `latitude`/`longitude` as null to clear the location.
}
